{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/public/:path*",
      "destination": "https://wanmoxing-cms.vercel.app/api/public/:path*"
    },
    {
      "source": "/api/blob/:path*",
      "destination": "https://wanmoxing-cms.vercel.app/api/blob/:path*"
    }
  ]
}
